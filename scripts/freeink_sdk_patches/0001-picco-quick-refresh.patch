+// Quick refresh: book pages and large redraws use mode 3 with the rails on;
+// FULL still uses the full waveform and powers off.
+static void expectQuick2677(Ssd2677Driver& s) {
+  EpdBus bus;
+  const auto lastLut2677 = [&]() -> const Bytes* {
+    const Bytes* lut = nullptr;
+    for (const auto& w : bus.writes)
+      if (w.command == 0x20) lut = &w.bytes;
+    return lut;
+  };
+  const auto sent = [&](uint8_t command) {
+    for (const auto& w : bus.writes)
+      if (w.command == command) return true;
+    return false;
+  };
+  const Bytes mode2(lut_picco_se0400_fast, lut_picco_se0400_fast + 535);
+  const Bytes mode3(lut_picco_se0400_mode3, lut_picco_se0400_mode3 + 535);
+  Bytes black(48000, 0x00), white(48000, 0xFF);
+  s.begin(bus);
+  s.display(bus, white.data(), nullptr, RefreshMode::Full, false);
+  s.setReaderRefresh(true);
+  bus.clear();
+  s.display(bus, black.data(), nullptr, RefreshMode::Fast, false);
+  assert(*lastLut2677() == mode2 && sent(0x02));  // normal: reading waveform, powered off
+  s.setQuickRefresh(true);
+  for (int i = 0; i < 2; ++i) {
+    bus.clear();
+    s.display(bus, (i ? black : white).data(), nullptr, RefreshMode::Fast, false);
+    assert(*lastLut2677() == mode3 && !sent(0x02) && !s._needsPowerOn);
+    assert(sent(0x04) == (i == 0));  // only the first frame powers on
+  }
+  s.setReaderRefresh(false);
+  bus.clear();
+  s.display(bus, white.data(), nullptr, RefreshMode::Fast, false);  // whole-screen UI redraw
+  assert(*lastLut2677() == mode3 && !sent(0x02));
+  bus.clear();
+  s.display(bus, black.data(), nullptr, RefreshMode::Full, false);
+  assert(*lastLut2677() == Bytes(lut_picco_se0400_full, lut_picco_se0400_full + 535) && sent(0x02));
+  s.setQuickRefresh(false);
+  bus.clear();
+  s.display(bus, white.data(), nullptr, RefreshMode::Fast, false);  // large redraw: mode 2 again
+  assert(*lastLut2677() == mode2 && sent(0x02));
+}
