wx-clear = sun
wx-partly = cloud-sun
wx-cloudy = cloud
wx-fog = cloud-fog
wx-drizzle = cloud-drizzle
wx-rain = cloud-rain
wx-snow = cloud-snow
wx-storm = cloud-lightning
