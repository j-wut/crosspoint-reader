+static GHashTable *esp32s3_io_seen;
+static void esp32s3_io_note(const char *what, hwaddr addr, uint64_t v)
+{
+    if (!esp32s3_io_seen) {
+        esp32s3_io_seen = g_hash_table_new(g_direct_hash, g_direct_equal);
+    }
+    gpointer key = GUINT_TO_POINTER((guint)(addr * 2 + (what[0] == 'w')));
+    if (!g_hash_table_contains(esp32s3_io_seen, key)) {
+        g_hash_table_add(esp32s3_io_seen, key);
+        qemu_log_mask(LOG_UNIMP, "[io] %s 0x%08" PRIx64 " = 0x%" PRIx64 "\n", what, (uint64_t)(ESP32S3_IO_START_ADDR + addr), v);
+    }
+}
+
